{
  "name": "music-management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "start:demo": "prisma migrate deploy && npm run db:seed && next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "user:create-admin": "node --env-file-if-exists=.env scripts/create-admin.ts"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "overrides": {
    "minimatch@>=7.0.0 <=11.0.0": "11.0.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "next": "16.4.5",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
