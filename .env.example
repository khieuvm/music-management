# Local development only. Replace credentials before any shared deployment.
POSTGRES_USER=classroom
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=classroom
POSTGRES_PORT=55432
DATABASE_URL=postgresql://classroom:local-development-only@127.0.0.1:55432/classroom
APP_URL=http://127.0.0.1:3000
# Replace with a random value before running a shared environment.
RATE_LIMIT_SECRET=local-development-replace-before-deploying
# Only for an explicitly trusted reverse proxy that overwrites X-Real-IP.
TRUST_PROXY=false
# Where uploaded homework videos are stored (back this folder up together with the database).
STORAGE_DIR=./storage
# Maximum video size per upload, in MB. The reverse proxy body limit must be at least this.
MAX_UPLOAD_MB=300
